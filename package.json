{
  "name": "project2",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "nvmuse": "source ~/.nvm/nvm.sh && nvm use",
    "preview": "astro preview",
    "shadcn": "npx shadcn@latest",
    "astro": "astro",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/make-og-image.mjs",
    "check:types": "astro check --minimumFailingSeverity warning",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:source": "node scripts/check-source.mjs --report-unused",
    "build:e2e": "PUBLIC_GTM_ID=GTM-QATEST0 astro build --outDir dist-e2e",
    "preview:e2e": "astro preview --outDir dist-e2e --port 4410",
    "test:static": "vitest run --project static",
    "test:unit": "vitest run --project unit",
    "test:dist": "astro build && npm run build:e2e && vitest run --project dist",
    "test:e2e": "npm run build:e2e && playwright test",
    "test": "npm run check:types && npm run test:static && npm run test:unit && npm run test:dist && playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@babel/runtime": "^7.28.4",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "animejs": "^4.4.1",
    "astro": "^5.13.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "motion": "^12.42.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-image": "^4.1.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.5.2",
    "jsdom": "~26.1.0",
    "playwright": "^1.62.1",
    "react-icons": "^5.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11"
  }
}
