---
import SectionShell from "@/components/common/astro/SectionShell.astro"
import { TimelineLine } from "@/components/experience/TimelineLine"
import { TimelineList } from "@/components/experience/TimelineList"
import experienceJson from "@/assets/experience.json"
---

<SectionShell
  id="experience"
  background="var(--color-surface-alt)"
  eyebrow="04. git log --oneline"
  headline="My Dev"
  headlineAccent="Journey"
  maxWidth="max-w-5xl"
>
  <div class="relative">
    <!-- Dynamic: animated vertical line -->
    <TimelineLine client:load />

    <!-- Dynamic: one island renders the whole ordered timeline -->
    <TimelineList client:load items={experienceJson} />
  </div>
</SectionShell>
