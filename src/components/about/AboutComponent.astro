---
import SectionShell from "@/components/common/astro/SectionShell.astro"
import { AboutImage } from "@/components/about/AboutImage"
import { AboutStats } from "@/components/about/AboutStats"
import { AboutCodeBlock } from "@/components/about/AboutCodeBlock"
import dataJson from "@/assets/data.json"

const baseUrl = import.meta.env.BASE_URL
const { user, about } = dataJson
const name = user.nameDisplay
const imagePath = user.image.path
const hoverImagePath = user.image.hoverpath

const renderBio = (text: string) =>
  text
    .replace("{{since}}", String(user.since))
    .replace("{{professional}}", String(user.professional))
---

<SectionShell
  id="about"
  eyebrow={about.eyebrow}
  headline={about.headline}
  headlineAccent={about.headlineAccent}
>

  <!-- The portrait moves to the backdrop slot: at full strength it competed
       with the copy for attention, and it is decoration, not information. The
       remaining content centres in the space it leaves. -->
  <div slot="backdrop" class="about-portrait-backdrop" aria-hidden="true">
    <AboutImage client:load name={name} imagePath={imagePath} hoverImagePath={hoverImagePath} baseUrl={baseUrl} />
  </div>

  <div class="grid lg:grid-cols-9 gap-5 xl:gap-8 items-center justify-items-center lg:justify-items-stretch max-w-5xl lg:max-w-none mx-auto">
    <!-- Bio + stats -->
    <div class="lg:col-span-4 flex flex-col gap-4 min-w-0 w-full">
      {about.bio.map((p) => (
        <p style="font-size: 0.92rem; color: var(--color-ink-dim); line-height: 1.7; font-family: 'Space Grotesk', sans-serif">
          {renderBio(p)}
        </p>
      ))}
      <AboutStats client:load stats={about.stats} />
    </div>

    <!-- Code block -->
    <div class="hidden md:block lg:col-span-5 min-w-0 w-full">
      <AboutCodeBlock client:load since={user.since} professional={user.professional} />
    </div>
  </div>

</SectionShell>
