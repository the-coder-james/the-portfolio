---
import SectionShell from "@/components/common/astro/SectionShell.astro"
import { AboutImage } from "@/components/about/AboutImage"
import { AboutStats } from "@/components/about/AboutStats"
import { AboutCodeBlock } from "@/components/about/AboutCodeBlock"
import { SkillsCategories } from "@/components/skills/SkillsCategories"
import { SkillsMindset } from "@/components/skills/SkillsMindset"
import { TimelineList } from "@/components/experience/TimelineList"
import FlowLink from "@/components/common/astro/FlowLink.astro"
import dataJson from "@/assets/data.json"
import experienceJson from "@/assets/experience.json"

const baseUrl = import.meta.env.BASE_URL
const { user, about, skills, flow } = dataJson
const name = user.nameDisplay
const imagePath = user.image.path
const hoverImagePath = user.image.hoverpath
const techstack = user.techstack
const extraSkills = user.extraSkills

// The three sub-sections, in reading order. Numbered like the steps of an
// instruction manual: the order is the story (who, with what, how).
const subs = Object.fromEntries(about.sections.map((s, i) => [s.id, { ...s, step: String(i + 1).padStart(2, "0") }]))
---

{/*
  About, Skills and Experience are one section of three sub-sections, laid
  out one after another. The section is the one place on the page allowed to
  run past a screen: it holds the most, and every part of it is meant to be
  read rather than glanced at.

  The sub-sections are plain Astro markup holding islands of their own --
  never slots passed into a React component, which would nest those islands
  (see CLAUDE.md).
*/}
<SectionShell
  id="about"
  eyebrow={about.eyebrow}
  headline={about.headline}
  headlineAccent={about.headlineAccent}
  class="about-section"
>
  <div class="about-subs">

    <!-- ── 01 Profile: who he is ── -->
    <section id="about-profile" class="about-sub" aria-labelledby="about-profile-title">
      <!-- The code block is a backdrop: a decorative sample, not content anyone
           reads line by line. The portrait and copy sit in front of it. -->
      <div class="about-code-backdrop" aria-hidden="true">
        <AboutCodeBlock client:idle since={user.since} professional={user.professional} />
      </div>

      <header class="about-sub-head">
        <p class="about-sub-step" aria-hidden="true">STEP {subs.profile.step}</p>
        <h3 id="about-profile-title" class="about-sub-title">
          <span aria-hidden="true">{subs.profile.icon}</span>{subs.profile.label}
        </h3>
        <p class="about-sub-lede">{subs.profile.lede}</p>
      </header>

      <div class="about-sub-body about-profile-grid">
        <div class="about-profile-portrait">
          <AboutImage client:idle name={name} imagePath={imagePath} hoverImagePath={hoverImagePath} baseUrl={baseUrl} />
        </div>
        <div class="about-profile-copy">
          {about.bio.map((p) => (
            <p class="about-bio">{p}</p>
          ))}
          <!-- The two counts the Journey pipeline cannot show. -->
          <AboutStats client:idle stats={about.stats} />
        </div>
      </div>
    </section>

    <!-- ── 02 Arsenal: what he works with ── -->
    <section id="about-arsenal" class="about-sub" aria-labelledby="about-arsenal-title">
      <header class="about-sub-head">
        <p class="about-sub-step" aria-hidden="true">STEP {subs.arsenal.step}</p>
        <h3 id="about-arsenal-title" class="about-sub-title">
          <span aria-hidden="true">{subs.arsenal.icon}</span>{subs.arsenal.label}
        </h3>
        <p class="about-sub-lede">{subs.arsenal.lede}</p>
      </header>

      <div class="about-sub-body">
        <SkillsCategories client:idle techstack={techstack} extraSkills={extraSkills} />
        <SkillsMindset client:idle cards={skills.mindset} />
      </div>
    </section>

    <!-- ── 03 Journey: how he got here ── -->
    <section id="about-journey" class="about-sub" aria-labelledby="about-journey-title">
      <header class="about-sub-head">
        <p class="about-sub-step" aria-hidden="true">STEP {subs.journey.step}</p>
        <h3 id="about-journey-title" class="about-sub-title">
          <span aria-hidden="true">{subs.journey.icon}</span>{subs.journey.label}
        </h3>
        <p class="about-sub-lede">{subs.journey.lede}</p>
      </header>

      <div class="about-sub-body">
        <TimelineList client:idle items={experienceJson} />
      </div>
    </section>

  </div>

  <!-- Forward step in the flow: about -> projects. A plain anchor: the page
       scrolls on to the next section. -->
  <div class="flow-row">
    <FlowLink label={flow.about.label} href={flow.about.href} />
  </div>
</SectionShell>
