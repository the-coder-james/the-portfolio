---
import { SectionHeading } from "@/components/common/tsx/SectionHeading"

/**
 * The shared frame for every tab panel.
 *
 * A panel is exactly one viewport tall, never more: the heading sits at a
 * fixed height and the slot below it takes the remaining space as a flex
 * child that is allowed to shrink (`min-h-0`). Panels whose content cannot
 * fit scroll *inside* that region rather than growing the document, so the
 * tab bar and footer stay put and only one thing on the page ever scrolls.
 *
 * Panels are transparent over the fixed .site-backdrop -- see the note on
 * .page-section in global.css.
 */
interface Props {
  id: string;
  eyebrow?: string;
  headline?: string;
  headlineAccent?: string;
  sub?: string;
  maxWidth?: string;
  class?: string;
  headingClass?: string;
  /** Let the content region scroll when it overflows the viewport. */
  scrollable?: boolean;
}

const {
  id,
  eyebrow,
  headline,
  headlineAccent,
  sub,
  maxWidth = "max-w-7xl",
  class: className = "",
  headingClass = "",
  scrollable = true,
} = Astro.props;

const hasHeading = Boolean(eyebrow || headline);
---

<section
  id={id}
  class:list={["page-section tabpanel panel-viewport", className]}
  role="tabpanel"
  aria-labelledby={`tab-${id}`}
  tabindex="-1"
>
  <slot name="backdrop" />

  <div class:list={[maxWidth, "panel-inner", "mx-auto w-full relative flex flex-col min-h-0"]}>
    {hasHeading && (
      <div class:list={["shrink-0", headingClass]}>
        <SectionHeading
          client:idle
          eyebrow={eyebrow}
          headline={headline}
          headlineAccent={headlineAccent}
          sub={sub}
          className="mb-0"
        />
      </div>
    )}

    <div class:list={["flex-1 min-h-0 flex flex-col", scrollable ? "panel-scroll" : ""]}>
      <slot />
    </div>
  </div>
</section>
