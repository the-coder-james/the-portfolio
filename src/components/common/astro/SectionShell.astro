---
import { SectionHeading } from "@/components/common/tsx/SectionHeading"

/**
 * The shared frame for every section of the one scrolling page.
 *
 * A section is at least one screen tall, its content centred in it, and it
 * grows with its content when that is taller: nothing in a section is clipped
 * or scrolled inside a box of its own.
 *
 * `.section-stage` and `.section-head` are what the scroll choreography in
 * global.css drives; the section itself carries the view timeline.
 *
 * Sections are transparent over the fixed .site-backdrop -- see the note on
 * .page-section in global.css.
 */
interface Props {
  id: string;
  eyebrow?: string;
  headline?: string;
  headlineAccent?: string;
  sub?: string;
  maxWidth?: string;
  class?: string;
  headingClass?: string;
}

const {
  id,
  eyebrow,
  headline,
  headlineAccent,
  sub,
  maxWidth = "max-w-7xl",
  class: className = "",
  headingClass = "",
} = Astro.props;

const hasHeading = Boolean(eyebrow || headline);
// A section without a heading of its own (Projects) renders one in its slot
// with this id, so every section is named by its visible heading.
const headingId = `${id}-title`;
---

<section
  id={id}
  class:list={["page-section panel-viewport", className]}
  aria-labelledby={headingId}
  tabindex="-1"
>
  <slot name="backdrop" />

  <div class:list={[maxWidth, "panel-inner section-stage", "mx-auto w-full relative flex flex-col"]}>
    {hasHeading && (
      <div class:list={["section-head shrink-0", headingClass]}>
        <SectionHeading
          client:idle
          eyebrow={eyebrow}
          headline={headline}
          headlineAccent={headlineAccent}
          sub={sub}
          headingId={headingId}
          className="mb-0"
        />
      </div>
    )}

    <div class="section-body flex flex-col">
      <slot />
    </div>

  </div>
</section>
