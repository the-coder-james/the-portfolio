---
import { SectionHeading } from "@/components/common/tsx/SectionHeading"

/**
 * The shared frame for every tab panel: the section element itself and the
 * eyebrow/headline heading block.
 *
 * Panels are shown one at a time, so this no longer carries a per-section
 * background or the seam gradients that used to blend stacked sections -- see
 * the note on .page-section in global.css. Every panel is transparent over the
 * fixed .site-backdrop, which is what the hero always did.
 *
 * Content is passed through the default slot. Panels that need extra
 * decoration behind their content can use the `backdrop` slot.
 */
interface Props {
  id: string;
  /** Small mono label above the headline. */
  eyebrow?: string;
  /** Headline text. */
  headline?: string;
  /** Trailing headline words, rendered with the gradient treatment. */
  headlineAccent?: string;
  /** Optional supporting line under the headline. */
  sub?: string;
  /** Width of the inner container. */
  maxWidth?: string;
  class?: string;
  headingClass?: string;
}

const {
  id,
  eyebrow,
  headline,
  headlineAccent,
  sub,
  maxWidth = "max-w-7xl",
  class: className = "py-28",
  headingClass = "mb-16",
} = Astro.props;

const hasHeading = Boolean(eyebrow || headline);
---

<section
  id={id}
  class:list={["page-section tabpanel min-h-screen flex flex-col justify-center", className]}
  role="tabpanel"
  aria-labelledby={`tab-${id}`}
  tabindex="-1"
>
  <slot name="backdrop" />

  <div class:list={[maxWidth, "mx-auto px-6 relative w-full"]}>
    {hasHeading && (
      <SectionHeading
        client:idle
        eyebrow={eyebrow}
        headline={headline}
        headlineAccent={headlineAccent}
        sub={sub}
        className={headingClass}
      />
    )}

    <slot />
  </div>
</section>
