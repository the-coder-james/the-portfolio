---
import { SectionHeading } from "@/components/common/tsx/SectionHeading"
import { ProjectsGrid } from "@/components/projects/ProjectsGrid"
import projectlistJson from "@/assets/projectlist.json"
import taglistJson from "@/assets/taglist.json"
import rolesJson from "@/assets/roles.json"
import providersJson from "@/assets/projectprovider.json"
import FlowLink from "@/components/common/astro/FlowLink.astro"
import dataJson from "@/assets/data.json"

const baseUrl = import.meta.env.BASE_URL
const { flow } = dataJson
---

{/*
  Projects builds its own section rather than using SectionShell, because on
  PC it is a deck: the section is one screen of scroll per slide of cards, and
  the frame below (heading, controls, the slide) sticks to the screen while the
  page scrolls through it. ProjectsGrid sets data-deck and --slides on this
  section once it knows how many slides the current filter makes; until then
  (and without JS, and on phones) the section is an ordinary block that grows
  with its cards.
*/}
<section id="projects" class="page-section projects-section" aria-labelledby="projects-title" tabindex="-1">
  <div class="projects-frame panel-viewport">
    <div class="projects-frame-inner section-stage max-w-[1600px] mx-auto w-full relative flex flex-col">
      <!-- Heading pairs with a project count set beside it -->
      <div class="section-head projects-head flex flex-col md:flex-row md:items-end justify-between mb-4 gap-2 shrink-0">
        <SectionHeading
          client:idle
          headingId="projects-title"
          eyebrow="featured_work.tsx"
          headline="Things I've"
          headlineAccent="Built"
        />
        <!-- The flow step rides in the heading row: the deck owns the bottom
             edge, where its pager and scroll cue sit. -->
        <div class="projects-meta flex items-center justify-between md:justify-end gap-3 shrink-0">
          <span style="font-size: 0.85rem; color: var(--color-ink-dim)">
            {projectlistJson.length}+ projects shipped
          </span>
          <FlowLink label={flow.projects.label} href={flow.projects.href} />
        </div>
      </div>

      <!-- Dynamic: search, filter boxes, and the cards -- a scroll-driven deck
           on PC, a swipe rail (or a paged list) on phones -->
      <ProjectsGrid
        client:load
        projects={projectlistJson}
        taglist={taglistJson}
        roles={rolesJson}
        providers={providersJson}
        baseUrl={baseUrl}
      />
    </div>
  </div>
</section>
