---
import SectionShell from "@/components/common/astro/SectionShell.astro"
import { SectionHeading } from "@/components/common/tsx/SectionHeading"
import { ProjectsGrid } from "@/components/projects/ProjectsGrid"
import projectlistJson from "@/assets/projectlist.json"
import taglistJson from "@/assets/taglist.json"
import rolesJson from "@/assets/roles.json"
import providersJson from "@/assets/projectprovider.json"
import FlowLink from "@/components/common/astro/FlowLink.astro"
import dataJson from "@/assets/data.json"

const baseUrl = import.meta.env.BASE_URL
const { flow } = dataJson
---

<SectionShell id="projects" scrollable={false} maxWidth="max-w-[1600px]">
  <!-- Section glow sits behind the content -->
  <div
    slot="backdrop"
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 70% 40% at 50% 60%, var(--tint-brand-04) 0%, transparent 70%)"
  >
  </div>

  <!-- Heading pairs with a project count set beside it -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-4 gap-2 shrink-0">
    <SectionHeading
      client:idle
      eyebrow="featured_work.tsx"
      headline="Things I've"
      headlineAccent="Built"
    />
    <!-- The flow step rides in the heading row rather than below the grid:
         the grid fills the panel and owns the bottom edge, where its scroll
         hint sits. A second element down there would fight it. -->
    <div class="flex items-center gap-3 shrink-0">
      <span style="font-size: 0.85rem; color: var(--color-ink-dim)">
        {projectlistJson.length}+ projects shipped
      </span>
      <FlowLink label={flow.projects.label} href={flow.projects.href} />
    </div>
  </div>

  <!-- Dynamic: grid + "See more" pagination island -->
  <ProjectsGrid
    client:load
    projects={projectlistJson}
    taglist={taglistJson}
    roles={rolesJson}
    providers={providersJson}
    baseUrl={baseUrl}
  />
</SectionShell>
