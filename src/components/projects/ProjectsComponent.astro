---
import SectionShell from "@/components/common/astro/SectionShell.astro"
import { ProjectsGrid } from "@/components/projects/ProjectsGrid"
import projectlistJson from "@/assets/projectlist.json"
import taglistJson from "@/assets/taglist.json"
import rolesJson from "@/assets/roles.json"
import providersJson from "@/assets/projectprovider.json"

const baseUrl = import.meta.env.BASE_URL
---

<SectionShell id="projects">
  <!-- Section glow sits behind the content -->
  <div
    slot="backdrop"
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 70% 40% at 50% 60%, var(--tint-brand-04) 0%, transparent 70%)"
  >
  </div>

  <!-- Heading pairs with a count, so it opts out of the shared heading block -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-16 gap-6">
    <div>
      <p class="font-mono mb-2" style="font-size: 0.75rem; color: var(--color-brand)">03. featured_work.tsx</p>
      <h2 style="font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700; color: var(--color-ink); font-family: 'Space Grotesk', sans-serif; line-height: 1.2">
        Things I've <span class="gradient-text">Built</span>
      </h2>
    </div>
    <span style="font-size: 0.85rem; color: var(--color-ink-dim); font-family: 'Space Grotesk', sans-serif">
      {projectlistJson.length}+ projects shipped
    </span>
  </div>

  <!-- Dynamic: grid + "See more" pagination island -->
  <ProjectsGrid
    client:load
    projects={projectlistJson}
    taglist={taglistJson}
    roles={rolesJson}
    providers={providersJson}
    baseUrl={baseUrl}
    initialCount={6}
    step={6}
  />
</SectionShell>
