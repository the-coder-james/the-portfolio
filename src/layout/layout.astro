---
import BaseHead from '@/components/common/astro/BaseHead.astro';
import { LoadingScreen } from '@/components/common/tsx/LoadingScreen';
const { title, noindex } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {/* Runs before first paint, so the theme never flashes. is:inline keeps
        Astro from bundling and deferring it. Light is the default; an explicit
        choice in localStorage always beats the OS preference. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const dark = saved
            ? saved === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch {}
      })();
    </script>
    <BaseHead title={title} noindex={noindex}/>
    <style is:global>
      #preboot-veil {
        position: fixed;
        inset: 0;
        z-index: 9998;
        background: var(--color-surface-base);
        pointer-events: none;
      }
    </style>
  </head>
  <body style="min-height: 100vh; overflow-x: hidden;">
    <div id="preboot-veil"></div>
    {/* Fixed page backdrop. Stays put while the content scrolls over it.
        Its gradients live in .site-backdrop so they follow the theme. */}
    <div class="site-backdrop" aria-hidden="true"></div>
    <a href="#main" class="skip-link">Skip to content</a>
    <LoadingScreen client:load />
    <slot />
    <script is:inline>
      // Remove the static veil once React's loading screen has mounted on top.
      // The React component handles the actual fade-out animation.
      requestAnimationFrame(() => {
        const v = document.getElementById('preboot-veil');
        if (v) v.remove();
      });
    </script>
  </body>
</html>
